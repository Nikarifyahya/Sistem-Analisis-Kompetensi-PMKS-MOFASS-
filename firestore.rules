rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles: Allow read and write so user profile information is saved
    match /users/{userId} {
      allow read, write: if true;
    }

    // Company profiles: Allow read and write so every company profile filled by user is saved and synced
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Assessments: Allow read and write so all assessments flow automatically to admin portal in real time
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Connection probe
    match /test/connection {
      allow read, write: if true;
    }

    // All documents fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
